
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Euphoria Book Store</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');
        .font-display { font-family: 'Cormorant Garamond', serif; }
        .font-body { font-family: 'Inter', sans-serif; }
        html { scroll-behavior: smooth; }
        .hero-image { animation: heroZoom 18s ease-in-out infinite alternate; }
        @keyframes heroZoom {
            from { transform: scale(1.05); }
            to { transform: scale(1.1); }
        }
    </style>
</head>
<body class="bg-[#F3EBDD] text-[#2C2725] font-body">
    <%- include('includes/nav.ejs') %>

    <!-- HERO SECTION -->
    <section class="hero-section relative min-h-[88vh] flex items-center overflow-hidden">
        <img src="/uploads/h4.jpg" alt="Beautiful old library" class="absolute inset-0 w-full h-full object-cover object-center scale-105 hero-image">
        <div class="absolute inset-0 bg-gradient-to-r from-[#2C2725]/80 via-[#2C2725]/45 to-[#2C2725]/70"></div>
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-[#B08D57]/10 rounded-full blur-3xl"></div>

        <div class="relative z-10 max-w-7xl mx-auto px-6 py-24 w-full">
            <div class="max-w-4xl mx-auto text-center">
                <p class="text-[#F1EACC] uppercase tracking-[0.4em] text-xs font-semibold mb-7 drop-shadow-lg">Est. for lovers of stories</p>

                <div class="flex items-center justify-center gap-4 mb-7">
                    <span class="h-px w-20 bg-[#B08D57]"></span>
                    <span class="text-[#B08D57] text-xl">✦</span>
                    <span class="h-px w-20 bg-[#B08D57]"></span>
                </div>

                <h1 class="font-display text-7xl md:text-9xl leading-none text-[#F3EBDD] tracking-wide drop-shadow-[0_4px_15px_rgba(0,0,0,0.5)]">Euphoria</h1>

                <p class="font-display italic text-2xl md:text-3xl text-[#F1EACC] mt-7 mb-7 drop-shadow-lg">Where every book opens a door to another world.</p>

                <p class="max-w-2xl mx-auto text-[#F3EBDD]/80 leading-8 text-sm md:text-base mb-10">
                    A quiet collection of stories, knowledge, imagination and remarkable lives — waiting to be discovered between the pages.
                </p>

                <div class="flex flex-wrap justify-center gap-4">
                    <a href="/books" class="bg-[#6B2737] text-[#F3EBDD] px-8 py-3.5 text-xs uppercase tracking-[0.2em] shadow-lg hover:bg-[#2C2725] hover:-translate-y-1 transition duration-300">Enter the Library</a>
                    <a href="/categories" class="border border-[#B08D57] text-[#F3EBDD] px-8 py-3.5 text-xs uppercase tracking-[0.2em] backdrop-blur-sm bg-[#B08D57] hover:text-[#2C2725] hover:-translate-y-1 transition duration-300">Explore Categories</a>
                </div>

                <div class="flex items-center justify-center gap-4 mt-14">
                    <span class="h-px w-24 bg-[#B08D57]/70"></span>
                    <span class="text-[#B08D57]">✦</span>
                    <span class="h-px w-24 bg-[#B08D57]/70"></span>
                </div>
            </div>
        </div>
    </section>

    <!-- ABOUT SECTION -->
    <section class="relative overflow-hidden px-6 py-20 md:py-28">
        <div class="pointer-events-none absolute -left-20 top-20 h-64 w-64 rounded-full bg-[#8C6046]/5 blur-3xl"></div>
        <div class="pointer-events-none absolute -right-20 bottom-0 h-72 w-72 rounded-full bg-[#6B2737]/5 blur-3xl"></div>

        <div class="relative mx-auto max-w-6xl">
            <div class="grid items-center gap-14 md:grid-cols-2 md:gap-20">
                <div class="relative">
                    <p class="mb-5 flex items-center gap-4 text-xs font-semibold uppercase tracking-[0.3em] text-[#96584E]">
                        Our Story <span class="h-px w-12 bg-[#8C6046]/70"></span>
                    </p>

                    <h2 class="mb-7 font-display text-5xl leading-[1.12] text-[#2C2725] md:text-6xl">
                        More than a <span class="italic text-[#6B2737]">collection</span> of books.
                    </h2>

                    <div class="mb-7 flex items-center gap-3">
                        <span class="h-px w-12 bg-[#8C6046]"></span>
                        <span class="text-lg text-[#8C6046]">✦</span>
                        <span class="h-px w-8 bg-[#8C6046]/40"></span>
                    </div>

                    <p class="mb-5 max-w-lg text-base leading-8 text-[#2C2725]/80 md:text-lg">Euphoria is a little sanctuary for people who find comfort between the pages of a good book.</p>

                    <p class="mb-8 max-w-lg text-base leading-8 text-[#2C2725]/70 md:text-lg">
                        From mysterious adventures and timeless stories to knowledge that changes the way we see the world, our shelves bring together books for every kind of reader.
                    </p>

                    <a href="/about" class="group inline-flex items-center gap-3 border-b border-[#6B2737] pb-2 text-xs font-semibold uppercase tracking-[0.2em] text-[#6B2737] transition duration-300 hover:gap-5 hover:border-[#96584E] hover:text-[#96584E]">
                        Discover Our Story
                        <span class="text-base transition-transform duration-300 group-hover:translate-x-1">→</span>
                    </a>

                    <p class="mt-10 font-display text-xl italic text-[#8C6046]">For the love of stories, always.</p>
                </div>

                <div class="relative mx-auto w-full max-w-lg">
                    <div class="absolute -right-3 -top-3 h-full w-full border border-[#8C6046]/60 md:-right-5 md:-top-5"></div>

                    <div class="relative border border-[#8C6046]/30 bg-[#E8DDC8] p-2 shadow-xl shadow-[#2C2725]/10">
                        <img src="/uploads/c1.jfif" alt="A peaceful reading corner surrounded by books" class="h-[390px] w-full object-cover md:h-[490px]" loading="lazy">
                        <div class="pointer-events-none absolute inset-2 bg-gradient-to-t from-[#1E1A18]/55 via-transparent to-transparent"></div>

                        <div class="absolute bottom-7 left-7 right-7 text-[#F1EACC]">
                            <p class="mb-2 text-[10px] uppercase tracking-[0.3em] text-[#E8C995]">A little escape</p>
                            <p class="font-display text-3xl italic md:text-4xl">Find yourself in a story.</p>
                            <div class="mt-4 h-px w-12 bg-[#C9A66B]"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- BOOKS INTRO -->
    <section class="px-6 py-24">
        <div class="max-w-6xl mx-auto text-center">
            <p class="text-[#96584E] uppercase tracking-[0.3em] text-xs font-semibold mb-4">The Collection</p>
            <h2 class="font-display text-5xl md:text-6xl text-[#2C2725] mb-5">Stories worth discovering</h2>

            <div class="flex items-center justify-center gap-4 mb-7">
                <span class="w-20 h-px bg-[#8C6046]/50"></span>
                <span class="text-[#8C6046]">✦</span>
                <span class="w-20 h-px bg-[#8C6046]/50"></span>
            </div>

            <p class="max-w-xl mx-auto text-[#2C2725]/60 leading-7 text-sm mb-10">
                Wander through our shelves and find something that feels like it was waiting specifically for you.
            </p>

            <a href="/books" class="inline-block bg-[#6B2737] text-[#F3EBDD] px-7 py-3 text-xs uppercase tracking-[0.2em] hover:bg-[#2C2725] transition duration-300">View All Books</a>
        </div>
    </section>

    <!-- CATEGORY SECTION -->
    <section class="relative px-6 py-24 bg-cover bg-center" style="background-image: url('/uploads/h3.jpg');">
        <div class="absolute inset-0 bg-[#1E1A18]/70"></div>

        <div class="relative z-10 max-w-6xl mx-auto">
            <div class="text-center mb-14">
                <p class="text-[#C9A66B] uppercase tracking-[0.3em] text-xs mb-4">The Euphoria Shelves</p>
                <h2 class="font-display text-5xl md:text-6xl text-[#F1EACC]">Find your next world</h2>

                <div class="flex justify-center items-center gap-3 mt-5">
                    <span class="w-16 h-px bg-[#B08D57]"></span>
                    <span class="text-[#C9A66B]">✦</span>
                    <span class="w-16 h-px bg-[#B08D57]"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#8C6046]/30">
                <!-- FICTION -->
                <a href="/categories/Fiction" class="group bg-[#78665A] p-10 hover:bg-[#96584E] transition duration-500">
                    <span class="text-[#8C6046]">I</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Fiction</h3>
                    <p class="text-[#F1EACC]/55 text-sm leading-6">Stories that carry you somewhere beyond the ordinary.</p>
                </a>

                <!-- ACADEMICS -->
                <a href="/categories/Academics" class="group bg-[#294536] p-10 hover:bg-[#789165] transition duration-500">
                    <span class="text-[#F1EACC]/60">II</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Academics</h3>
                    <p class="text-[#F1EACC]/60 text-sm leading-6">Books that fuel curiosity, learning and discovery.</p>
                </a>

                <!-- MYSTERY -->
                <a href="/categories/Mystery" class="group bg-[#78665A] p-10 hover:bg-[#96584E] transition duration-500">
                    <span class="text-[#8C6046]">III</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Mystery</h3>
                    <p class="text-[#F1EACC]/55 text-sm leading-6">Secrets hidden between the pages.</p>
                </a>

                <!-- FANTASY -->
                <a href="/categories/Fantasy" class="group bg-[#294536] p-10 hover:bg-[#789165] transition duration-500">
                    <span class="text-[#F1EACC]/60">IV</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Fantasy</h3>
                    <p class="text-[#F1EACC]/60 text-sm leading-6">Magical realms and impossible adventures.</p>
                </a>

                <!-- SCIENCE -->
                <a href="/categories/Science" class="group bg-[#78665A] p-10 hover:bg-[#96584E] transition duration-500">
                    <span class="text-[#8C6046]">V</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Science</h3>
                    <p class="text-[#F1EACC]/55 text-sm leading-6">Discoveries, ideas and mysteries of our world.</p>
                </a>

                <!-- BIOGRAPHY -->
                <a href="/categories/Biography" class="group bg-[#294536] p-10 hover:bg-[#789165] transition duration-500">
                    <span class="text-[#F1EACC]/60">VI</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Biography</h3>
                    <p class="text-[#F1EACC]/60 text-sm leading-6">Remarkable lives and stories worth remembering.</p>
                </a>
            </div>
        </div>
    </section>

    <!-- CONTACT CTA -->
    <section class="px-6 py-24 bg-[#E8DDC8]">
        <div class="max-w-4xl mx-auto text-center">
            <p class="text-[#96584E] uppercase tracking-[0.3em] text-xs mb-5">Leave a note</p>
            <h2 class="font-display text-5xl md:text-6xl text-[#2C2725] mb-6">Have something to tell us?</h2>

            <p class="max-w-xl mx-auto text-[#2C2725]/60 leading-7 mb-9">
                Whether you have a question, a suggestion, or simply want to say hello, our pages are always open.
            </p>

            <a href="/contact" class="inline-block bg-[#6B2737] text-[#F3EBDD] px-8 py-3.5 text-xs uppercase tracking-[0.2em] hover:bg-[#2C2725] transition duration-300">Contact Euphoria</a>
        </div>
    </section>

    <!-- FOOTER -->
    <%- include('includes/footer.ejs') %>
</body>
</html>
