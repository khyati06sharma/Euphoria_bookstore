
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Book - Euphoria</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-[#F3EBDD] text-[#1E1A18]">
    <%- include('includes/nav.ejs') %>

    <section class="px-6 py-16">
        <div class="max-w-2xl mx-auto">
            <p class="text-center text-[#6B2737] uppercase tracking-[0.3em] text-sm mb-4">The Collection</p>
            <h1 class="text-center font-serif text-5xl text-[#3A2922] mb-5">Add a New Book</h1>

            <div class="flex items-center justify-center gap-3 mb-12">
                <span class="h-px w-16 bg-[#B08D57]"></span>
                <span class="text-[#B08D57]">✦</span>
                <span class="h-px w-16 bg-[#B08D57]"></span>
            </div>

            <form action="/books" method="post" enctype="multipart/form-data" class="border border-[#B08D57]/50 bg-[#E8DDC8] p-8 md:p-10 shadow-lg">
                <div class="mb-6">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">Title</label>
                    <input type="text" name="title" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#3A2922]/20 focus:outline-none focus:border-[#6B2737]">
                </div>

                <div class="mb-6">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">Author</label>
                    <input type="text" name="author" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#3A2922]/20 focus:outline-none focus:border-[#6B2737]">
                </div>

                <div class="mb-6">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">Price</label>
                    <input type="number" name="price" min="0" step="0.01" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#3A2922]/20 focus:outline-none focus:border-[#6B2737]">
                </div>

                <div class="mb-6">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">Category</label>
                    <input type="text" name="category" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#3A2922]/20 focus:outline-none focus:border-[#6B2737]">
                </div>

                <div class="mb-8">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">Image</label>
                    <input type="file" name="img" accept="image/*" required class="w-full px-4 py-3 bg-[#F3EBDD] border border-[#3A2922]/20">
                </div>

                <button type="submit" class="w-full bg-[#6B2737] text-[#F3EBDD] py-3 uppercase tracking-wider text-sm hover:bg-[#3A2922] transition duration-300">Add to Collection</button>
            </form>
        </div>
    </section>

    <%- include('includes/footer.ejs') %>
</body>
</html>
