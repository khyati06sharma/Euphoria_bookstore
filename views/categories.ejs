
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Categories - Euphoria</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');

        .font-display {
            font-family: 'Cormorant Garamond', serif;
        }

        .font-body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-[#F3EBDD] text-[#1E1A18] font-body">
    <%- include('includes/nav.ejs') %>

    <section class="pt-20 pb-12 px-6">
        <div class="max-w-6xl mx-auto text-center">
            <p class="text-[#96584E] uppercase tracking-[0.35em] text-xs font-semibold mb-4">Explore the collection</p>
            <h1 class="font-display text-6xl md:text-7xl text-[#2C2725] mb-5">Browse by Category</h1>
            <div class="flex items-center justify-center gap-4 mb-6">
                <span class="w-20 h-px bg-[#8C6046]/50"></span>
                <span class="text-[#8C6046] text-lg">✦</span>
                <span class="w-20 h-px bg-[#8C6046]/50"></span>
            </div>
            <p class="max-w-xl mx-auto text-[#2C2725]/65 leading-7 text-sm">
                Wander through the shelves and discover stories, knowledge and remarkable lives gathered within Euphoria.
            </p>
        </div>
    </section>

    <section class="px-6 pb-16">
        <div class="max-w-5xl mx-auto">
            <div class="bg-[#E8DDC8]/70 border border-[#8C6046]/30 px-5 py-4 shadow-sm">
                <div class="flex flex-wrap items-center justify-center gap-2">
                    <a href="/categories" class="px-5 py-2.5 text-xs uppercase tracking-widest text-[#F1EACC] bg-[#2C2725] hover:bg-[#96584E] transition duration-300">All Books</a>
                    <a href="/categories/Fantasy" class="px-5 py-2.5 text-xs uppercase tracking-widest text-[#2C2725] border border-[#8C6046]/30 hover:bg-[#789165] hover:text-[#F1EACC] transition duration-300">Fantasy</a>
                    <a href="/categories/Biography" class="px-5 py-2.5 text-xs uppercase tracking-widest text-[#2C2725] border border-[#8C6046]/30 hover:bg-[#789165] hover:text-[#F1EACC] transition duration-300">Biography</a>
                    <a href="/categories/Academics" class="px-5 py-2.5 text-xs uppercase tracking-widest text-[#2C2725] border border-[#8C6046]/30 hover:bg-[#789165] hover:text-[#F1EACC] transition duration-300">Academics</a>
                    <a href="/categories/Fiction" class="px-5 py-2.5 text-xs uppercase tracking-widest text-[#2C2725] border border-[#8C6046]/30 hover:bg-[#789165] hover:text-[#F1EACC] transition duration-300">Fiction</a>
                    <a href="/categories/Mystery" class="px-5 py-2.5 text-xs uppercase tracking-widest text-[#2C2725] border border-[#8C6046]/30 hover:bg-[#789165] hover:text-[#F1EACC] transition duration-300">Mystery</a>
                    <a href="/categories/Science" class="px-5 py-2.5 text-xs uppercase tracking-widest text-[#2C2725] border border-[#8C6046]/30 hover:bg-[#789165] hover:text-[#F1EACC] transition duration-300">Science</a>
                </div>
            </div>
        </div>
    </section>

    <section class="px-6 pb-20">
        <div class="max-w-7xl mx-auto">
            <% if (books.length > 0) { %>
                <div class="relative mb-5">
                    <p class="text-center text-[#6B2737] uppercase tracking-[0.3em] text-sm mb-4">The Collection</p>
                    <h2 class="text-center font-display text-5xl md:text-6xl text-[#3A2922]">Books in this collection</h2>
                </div>

                <div class="flex items-center justify-center gap-3 mb-14">
                    <span class="h-px w-20 bg-[#B08D57]"></span>
                    <span class="text-[#B08D57]">✦</span>
                    <span class="h-px w-20 bg-[#B08D57]"></span>
                </div>

                <main class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                    <% books.forEach(book => { %>
                        <article class="bg-[#E8DDC8] border border-[#B08D57]/50 shadow-md hover:shadow-xl transition duration-300">
                            <div class="h-1.5 bg-[#6B2737]"></div>
                            <div class="p-5">
                                <div class="mt-2 mb-4 w-full h-64 overflow-hidden bg-[#E8DDC8] flex items-center justify-center">
                                    <img src="<%= book.image.startsWith('/') ? book.image : '/' + book.image %>" alt="<%= book.title %>" loading="lazy" class="w-full h-full object-contain">
                                </div>

                                <p class="text-[#8C6046] text-xs uppercase tracking-[0.18em] mb-2"><%= book.category %></p>
                                <h2 class="font-display text-2xl md:text-3xl font-semibold text-[#3A2922] leading-tight mb-4"><%= book.title %></h2>

                                <div class="space-y-3 text-sm">
                                    <p class="text-[#3A2922]/80">
                                        <span class="text-[#294536] font-semibold">Author</span><br>
                                        <%= book.author %>
                                    </p>
                                    <p class="text-[#3A2922]/80">
                                        <span class="text-[#294536] font-semibold">Price</span><br>
                                        <span class="text-base font-medium text-[#3A2922]">₹<%= book.price %></span>
                                    </p>
                                </div>

                                
<div class="mt-5 pt-4 border-t border-[#B08D57]/40">

    <% if (isAdmin) { %>

        <!-- Admin buttons -->
        <div class="flex gap-3">
            <a href="/books/edit/<%= book._id %>"
               class="flex-1 text-center px-4 py-2.5 border border-[#8C6046] text-[#3A2922] text-xs uppercase tracking-widest hover:bg-[#789165] hover:text-[#F1EACC] transition duration-300">
                Edit
            </a>

            <form action="/books/delete/<%= book._id %>" method="POST" class="flex-1">
                <button type="submit"
                    onclick="return confirm('Are you sure you want to delete this book?')"
                    class="w-full px-4 py-2.5 bg-[#6B2737] text-[#F1EACC] text-xs uppercase tracking-widest hover:bg-[#3A2922] transition duration-300">
                    Delete
                </button>
            </form>
        </div>

    <% } else { %>

        <!-- Customer buttons -->
        <div class="grid grid-cols-2 gap-2.5">
            <form action="/checkout/buy-now/<%= book._id %>" method="POST">
                <button type="submit"
                    class="w-full bg-[#294536] text-[#F1EACC] py-2.5 text-sm tracking-wide hover:bg-[#1E3327] transition duration-300">
                    Buy Now
                </button>
            </form>

            <form action="/cart/add/<%= book._id %>" method="POST">
                <button type="submit"
                    class="w-full border border-[#294536] text-[#294536] py-2.5 text-sm tracking-wide hover:bg-[#294536] hover:text-[#F1EACC] transition duration-300">
                    Add to Cart
                </button>
            </form>
        </div>

    <% } %>

</div>

                            </div>
                        </article>
                    <% }) %>
                </main>
            <% } else { %>
                <div class="max-w-xl mx-auto text-center border border-[#8C6046]/25 bg-[#E8DDC8]/40 px-8 py-16">
                    <h2 class="font-display text-4xl text-[#2C2725] mb-3">The shelves are quiet</h2>
                    <p class="text-sm text-[#2C2725]/60 leading-7 mb-7">
                        There are currently no books in this category. Perhaps another shelf holds the story you're looking for.
                    </p>
                    <a href="/categories" class="inline-block bg-[#2C2725] text-[#F1EACC] px-6 py-3 text-xs uppercase tracking-widest hover:bg-[#96584E] transition duration-300">View All Books</a>
                </div>
            <% } %>
        </div>
    </section>

    <section class="relative px-6 py-24 bg-cover bg-center" style="background-image: url('/uploads/h3.jpg');">
        <div class="absolute inset-0 bg-[#1E1A18]/70"></div>
        <div class="relative z-10 max-w-6xl mx-auto">
            <div class="text-center mb-14">
                <p class="text-[#C9A66B] uppercase tracking-[0.3em] text-xs mb-4">The Euphoria Shelves</p>
                <h2 class="font-display text-5xl md:text-6xl text-[#F1EACC]">Find your next world</h2>
                <div class="flex justify-center items-center gap-3 mt-5">
                    <span class="w-16 h-px bg-[#B08D57]"></span>
                    <span class="text-[#C9A66B]">✦</span>
                    <span class="w-16 h-px bg-[#B08D57]"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#8C6046]/30">
                <a href="/categories/Fiction" class="group bg-[#78665A] p-10 hover:bg-[#96584E] transition duration-500">
                    <span class="text-[#8C6046]">I</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Fiction</h3>
                    <p class="text-[#F1EACC]/55 text-sm leading-6">Stories that carry you somewhere beyond the ordinary.</p>
                </a>

                <a href="/categories/Academics" class="group bg-[#294536] p-10 hover:bg-[#789165] transition duration-500">
                    <span class="text-[#F1EACC]/60">II</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Academics</h3>
                    <p class="text-[#F1EACC]/60 text-sm leading-6">Books that fuel curiosity, learning and discovery.</p>
                </a>

                <a href="/categories/Mystery" class="group bg-[#78665A] p-10 hover:bg-[#96584E] transition duration-500">
                    <span class="text-[#8C6046]">III</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Mystery</h3>
                    <p class="text-[#F1EACC]/55 text-sm leading-6">Secrets hidden between the pages.</p>
                </a>

                <a href="/categories/Fantasy" class="group bg-[#294536] p-10 hover:bg-[#789165] transition duration-500">
                    <span class="text-[#F1EACC]/60">IV</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Fantasy</h3>
                    <p class="text-[#F1EACC]/60 text-sm leading-6">Magical realms and impossible adventures.</p>
                </a>

                <a href="/categories/Science" class="group bg-[#78665A] p-10 hover:bg-[#96584E] transition duration-500">
                    <span class="text-[#8C6046]">V</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Science</h3>
                    <p class="text-[#F1EACC]/55 text-sm leading-6">Discoveries, ideas and mysteries of our world.</p>
                </a>

                <a href="/categories/Biography" class="group bg-[#294536] p-10 hover:bg-[#789165] transition duration-500">
                    <span class="text-[#F1EACC]/60">VI</span>
                    <h3 class="font-display text-4xl text-[#F1EACC] mt-3 mb-3 group-hover:translate-x-2 transition duration-300">Biography</h3>
                    <p class="text-[#F1EACC]/60 text-sm leading-6">Remarkable lives and stories worth remembering.</p>
                </a>
            </div>
        </div>
    </section>

    <%- include('includes/footer.ejs') %>
</body>
</html>
