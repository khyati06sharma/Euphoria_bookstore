<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact - Euphoria</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="bg-[#F3EBDD] text-[#1E1A18]">

    <%- include('includes/nav.ejs') %>

    <section class="px-6 py-16">

        <div class="max-w-2xl mx-auto">

            <p class="text-center text-[#6B2737] uppercase tracking-[0.3em] text-sm mb-4">
                Write to us
            </p>

            <h1 class="text-center font-serif text-5xl text-[#3A2922] mb-5">
                Contact Us
            </h1>

            <p class="text-center text-[#294536] mb-12">
                Have a question? Leave a note between the pages.
            </p>

            <form action="/contact" method="post"
                  class="border-y border-[#B08D57]/50 py-10">

                <div class="mb-6">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">
                        Name
                    </label>

                    <input type="text" name="name" required
                           class="w-full px-4 py-3 bg-transparent border-b border-[#3A2922]/40 focus:outline-none focus:border-[#6B2737] transition duration-300">
                </div>

                <div class="mb-6">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">
                        Email
                    </label>

                    <input type="email" name="email" required
                           class="w-full px-4 py-3 bg-transparent border-b border-[#3A2922]/40 focus:outline-none focus:border-[#6B2737] transition duration-300">
                </div>

                <div class="mb-6">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">
                        Mobile
                    </label>

                    <input type="tel" name="mobile" required
                           class="w-full px-4 py-3 bg-transparent border-b border-[#3A2922]/40 focus:outline-none focus:border-[#6B2737] transition duration-300">
                </div>

                <div class="mb-8">
                    <label class="block text-[#294536] text-sm uppercase tracking-wider mb-2">
                        Message
                    </label>

                    <textarea name="message" required
                              class="w-full px-4 py-3 bg-transparent border-b border-[#3A2922]/40 focus:outline-none focus:border-[#6B2737] transition duration-300 min-h-32"></textarea>
                </div>

                <button type="submit"
                        class="w-full bg-[#6B2737] text-[#F3EBDD] py-3 uppercase tracking-wider text-sm hover:bg-[#3A2922] transition duration-300">
                    Send Message
                </button>

            </form>

        </div>

    </section>
    <%- include('includes/footer.ejs') %>

</body>
</html>