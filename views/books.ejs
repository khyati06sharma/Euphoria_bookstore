
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Books - Euphoria</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap');

        .font-display {
            font-family: 'Cormorant Garamond', serif;
        }

        .font-body {
            font-family: 'Inter', sans-serif;
        }
    </style>
</head>
<body class="bg-[#F3EBDD] text-[#1E1A18] font-body">
    <%- include('includes/nav.ejs') %>

    <% if (isAdmin) { %>
        <div class="max-w-7xl mx-auto px-6 flex justify-end gap-3 mt-6">
            <a href="/books/new" class="bg-[#6B2737] text-[#F3EBDD] px-5 py-3 uppercase tracking-wider text-sm hover:bg-[#3A2922] transition duration-300">+ Add Book</a>
            <a href="/admin/logout" class="border border-[#6B2737] text-[#6B2737] px-5 py-3 uppercase tracking-wider text-sm hover:bg-[#789165] hover:text-[#F3EBDD] transition duration-300">Logout</a>
        </div>
    <% } %>

    <section class="px-6 py-12 md:py-16">
        <div class="max-w-7xl mx-auto">
            <div class="relative mb-5">
                <p class="text-center text-[#6B2737] uppercase tracking-[0.3em] text-xs sm:text-sm mb-4">The Collection</p>
                <h1 class="text-center font-display text-5xl md:text-6xl text-[#3A2922]">Our Books</h1>
            </div>

            <div class="flex items-center justify-center gap-3 mb-12">
                <span class="h-px w-20 bg-[#B08D57]"></span>
                <span class="text-[#B08D57]">✦</span>
                <span class="h-px w-20 bg-[#B08D57]"></span>
            </div>

            <main class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
                <% books.forEach(book => { %>
                    <article class="bg-[#E8DDC8] border border-[#B08D57]/50 shadow-md hover:shadow-xl transition duration-300">
                        <div class="h-1.5 bg-[#6B2737]"></div>

                        <div class="p-5">
                            <div class="mt-2 mb-4 w-full h-64 overflow-hidden bg-[#E8DDC8] flex items-center justify-center">
                                <img src="<%= book.image %>" alt="<%= book.title %>" loading="lazy" class="w-full h-full object-contain">
                            </div>

                            <p class="text-[#8C6046] text-xs uppercase tracking-[0.18em] mb-2"><%= book.category %></p>

                            <h2 class="font-display text-2xl md:text-3xl font-semibold text-[#3A2922] leading-tight mb-4"><%= book.title %></h2>

                            <div class="space-y-3 text-sm">
                                <p class="text-[#3A2922]/80">
                                    <span class="text-[#294536] font-semibold">Author</span><br>
                                    <%= book.author %>
                                </p>

                                <p class="text-[#3A2922]/80">
                                    <span class="text-[#294536] font-semibold">Price</span><br>
                                    <span class="text-base font-medium text-[#3A2922]">₹<%= book.price %></span>
                                </p>
                            </div>

                            <div class="mt-5 pt-4 border-t border-[#B08D57]/40">
                                <div class="grid grid-cols-2 gap-2.5">
                                    <form action="/checkout/buy-now/<%= book._id %>" method="POST">
                                        <button type="submit" class="w-full bg-[#294536] text-[#F1EACC] py-2.5 text-sm tracking-wide hover:bg-[#1E3327] transition duration-300">Buy Now</button>
                                    </form>

                                    <form action="/cart/add/<%= book._id %>" method="POST">
                                        <button type="submit" class="w-full border border-[#294536] text-[#294536] py-2.5 text-sm tracking-wide hover:bg-[#294536] hover:text-[#F1EACC] transition duration-300">Add to Cart</button>
                                    </form>
                                </div>

                                <% if (isAdmin) { %>
                                    <div class="flex gap-3 mt-4 pt-3 border-t border-[#B08D57]/30">
                                        <a href="/books/edit/<%= book._id %>" class="px-4 py-2 border border-[#8C6046] text-[#3A2922] text-xs uppercase tracking-widest hover:bg-[#789165] hover:text-[#F1EACC] transition duration-300">Edit</a>

                                        <form action="/books/delete/<%= book._id %>" method="POST">
                                            <button type="submit" onclick="return confirm('Are you sure you want to delete this book?')" class="px-4 py-2 bg-[#6B2737] text-[#F1EACC] text-xs uppercase tracking-widest hover:bg-[#3A2922] transition duration-300">Delete</button>
                                        </form>
                                    </div>
                                <% } %>
                            </div>
                        </div>
                    </article>
                <% }) %>
            </main>
        </div>
    </section>

    <%- include('includes/footer.ejs') %>
</body>
</html>
